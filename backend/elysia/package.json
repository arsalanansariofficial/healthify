{
  "name": "task-manager-api",
  "version": "0.0.0",
  "keywords": [
    "typescript",
    "elysia",
    "bun"
  ],
  "author": {
    "name": "Arsalan Ansari"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build --minify --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "build:js": "bun build src/index.ts --target=bun --minify-whitespace --minify-syntax --outfile dist/index.js",
    "dev": "bun --watch src/server.ts",
    "format": "prettier -w .",
    "prisma:deploy": "prisma migrate deploy --config src/lib/prisma/prisma.config.ts",
    "prisma:generate": "prisma generate --config src/lib/prisma/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config src/lib/prisma/prisma.config.ts",
    "prisma:reset": "prisma migrate reset -f --config src/lib/prisma/prisma.config.ts",
    "start": "bun --watch src/index.ts",
    "start:js": "bun --watch dist/index.js",
    "test": "bun test --watch",
    "test:prisma:deploy": "prisma migrate deploy --config src/lib/prisma/prisma.test.config.ts",
    "test:prisma:reset": "prisma migrate reset -f --config src/lib/prisma/prisma.test.config.ts"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.11",
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.0",
    "elysia": "latest",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "bun-types": "latest",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-sql": "^0.20.0",
    "prisma": "^7.9.0",
    "typescript-eslint": "^8.65.0"
  }
}
