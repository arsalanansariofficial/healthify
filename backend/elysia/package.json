{
  "name": "task-manager-api",
  "version": "0.0.0",
  "keywords": [
    "typescript",
    "elysia",
    "bun"
  ],
  "author": {
    "name": "Arsalan Ansari"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build --minify --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "build:js": "bun build src/index.ts --target=bun --minify-whitespace --minify-syntax --outfile ./dist/index.js",
    "dev": "bun run --watch src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.11",
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "elysia": "latest",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "bun-types": "latest",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "typescript-eslint": "^8.65.0"
  }
}
