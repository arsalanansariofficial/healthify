{
  "name": "server",
  "version": "1.0.0",
  "keywords": [
    "typescript",
    "elysia",
    "bun"
  ],
  "author": {
    "name": "Arsalan Ansari"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "auth:generate": "bunx --bun auth@latest generate",
    "auth:generate:admin": "bunx --bun auth@latest create-admin --email admin@server.com --password admin --name admin --role admin --yes",
    "build:bin": "bun build --minify --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "build:js": "bun build src/index.ts --target=bun --minify-whitespace --minify-syntax --outfile dist/index.js",
    "clean": "rm -rf node_modules",
    "db:generate": "bun --bun drizzle-kit generate --config src/lib/db/config.ts",
    "db:migrate": "bun --bun drizzle-kit migrate --config src/lib/db/config.ts",
    "db:push": "bun --bun drizzle-kit push --config src/lib/db/config.ts",
    "dev": "bun --watch src/index.ts",
    "dev:server": "bun --watch src/server.ts",
    "fix": "eslint --fix && prettier -w .",
    "secret": "openssl rand -base64 32",
    "setup": "bun clean && bun i && bun --bun drizzle-kit migrate --config src/lib/db/config.ts",
    "start:bin": "server",
    "start:js": "bun --watch dist/index.js",
    "test": "bun test --watch",
    "test:db:push": "bun --bun --env-file=.env.test.local drizzle-kit push --config src/lib/db/config.ts",
    "test:setup": "bun clean && bun i && bun --bun --env-file=.env.test.local drizzle-kit push --config src/lib/db/config.ts"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.11",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "drizzle-seed": "^0.3.1",
    "elysia": "latest",
    "nodemailer": "^9.0.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/parser": "^8.70.1",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-sql": "^0.20.0",
    "typescript-eslint": "^8.65.0"
  }
}
