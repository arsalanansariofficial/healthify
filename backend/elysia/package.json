{
  "name": "server",
  "version": "1.0.0",
  "keywords": [
    "typescript",
    "elysia",
    "bun"
  ],
  "author": {
    "name": "Arsalan Ansari"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "admin:create": "bunx --bun auth@latest create-admin --email admin@server.com --password admin --name admin --role admin --yes",
    "auth:generate": "bunx --bun auth@latest generate",
    "build": "bun build --minify --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "build:js": "bun build src/index.ts --target=bun --minify-whitespace --minify-syntax --outfile dist/index.js",
    "clean": "rm -rf node_modules generated",
    "db:generate": "drizzle-kit generate --config src/lib/db/config.ts",
    "db:migrate": "drizzle-kit migrate --config src/lib/db/config.ts",
    "db:push": "drizzle-kit push --config src/lib/db/config.ts",
    "dev": "bun --watch src/server.ts",
    "fix": "eslint --fix && prettier -w .",
    "generate:secret": "openssl rand -base64 32",
    "prisma:create": "prisma migrate dev --config src/lib/prisma/prisma.config.ts --create-only",
    "prisma:deploy": "prisma migrate deploy --config src/lib/prisma/prisma.config.ts",
    "prisma:generate": "prisma generate --config src/lib/prisma/prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config src/lib/prisma/prisma.config.ts",
    "prisma:reset": "prisma migrate reset -f --config src/lib/prisma/prisma.config.ts",
    "setup": "bun clean && bun i && bun prisma:deploy && bun prisma:generate",
    "start": "bun --watch src/index.ts",
    "start:js": "bun --watch dist/index.js",
    "test": "bun test --watch",
    "test:prisma:deploy": "prisma migrate deploy --config src/lib/prisma/prisma.test.config.ts",
    "test:prisma:reset": "prisma migrate reset -f --config src/lib/prisma/prisma.test.config.ts",
    "test:setup": "bun clean && bun i && bun test:prisma:deploy && bun prisma:generate"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.2",
    "@elysia/eden": "^1.4.10",
    "@elysia/static": "^1.4.11",
    "@prisma/adapter-mariadb": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "latest",
    "eslint-plugin-drizzle": "^0.2.3",
    "nodemailer": "^9.0.5",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/nodemailer": "^8.0.1",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^10.7.0",
    "eslint-plugin-perfectionist": "^5.10.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-sql": "^0.20.0",
    "prisma": "^7.9.0",
    "typescript-eslint": "^8.65.0"
  }
}
