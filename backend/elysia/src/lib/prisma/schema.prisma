model User {
  id String @id @default(uuid())

  name  String
  email String @unique

  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  image String?

  profile  UserProfile?
  sessions Session[]
  accounts Account[]
  tasks    Task[]
}

model Account {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  issuer     String
  accountId  String
  providerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idToken               String?
  scope                 String?
  password              String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  refreshToken          String?
  refreshTokenExpiresAt DateTime?

  @@unique([issuer, accountId])
  @@index([userId])
}

model Session {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  @@index([userId])
}

model Verification {
  id String @id @default(uuid())

  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phoneNumber String? @unique
  image       String?
  cover       String?
  bio         String?
  address     String?
  gender      Gender?
}

model Task {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      Status?
  description String?
}

enum Gender {
  male
  female
}

enum Status {
  complete
  incomplete
}

generator client {
  provider = "prisma-client"
  output   = "../../../generated/prisma"
}

datasource db {
  provider = "mysql"
}
