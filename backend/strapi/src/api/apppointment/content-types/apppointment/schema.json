{
  "kind": "collectionType",
  "collectionName": "apppointments",
  "info": {
    "singularName": "apppointment",
    "pluralName": "apppointments",
    "displayName": "Apppointment"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "prescription": {
      "type": "richtext"
    },
    "notes": {
      "type": "richtext"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "start": {
      "type": "time",
      "required": true
    },
    "end": {
      "type": "time",
      "required": true
    },
    "priority": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Low",
        "Normal",
        "High",
        "Urgent"
      ]
    },
    "appointmentStatus": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Pending",
        "Confirmed",
        "Cancelled",
        "Completed"
      ]
    },
    "patient": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "apppointments"
    },
    "doctor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::doctor.doctor",
      "inversedBy": "apppointments"
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5
    }
  }
}
