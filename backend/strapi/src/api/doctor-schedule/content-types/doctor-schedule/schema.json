{
  "kind": "collectionType",
  "collectionName": "doctor_schedules",
  "info": {
    "singularName": "doctor-schedule",
    "pluralName": "doctor-schedules",
    "displayName": "DoctorSchedule"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "day": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Sunday",
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday"
      ]
    },
    "start": {
      "type": "time",
      "required": true
    },
    "end": {
      "type": "time",
      "required": true
    },
    "doctor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::doctor.doctor",
      "inversedBy": "timings"
    }
  }
}
